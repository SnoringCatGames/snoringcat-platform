# Caddy reverse proxy + automatic Let's Encrypt for Nakama,
# Grafana, and the WebRTC/WS signaling proxy.
{
	email admin@snoringcat.games
	# Load global rate-limit zones (see github.com/mholt/caddy-ratelimit).
	order rate_limit before basicauth
	# Bind the admin/metrics endpoint to the container's
	# Docker-internal interface so Prometheus (sibling
	# container) can scrape `/metrics`. The Cloud firewall
	# blocks 2019/tcp from the public internet; only
	# nakama-net peers can reach it. Default `localhost:2019`
	# is unreachable from other containers (lo isn't shared
	# across docker-network namespaces).
	admin 0.0.0.0:2019
}

# Structured JSON access log shared by every site block. Written to
# a host-bind-mounted path (see docker-compose caddy volumes) so the
# caddy-access-analytics job can read it over SSH. Caddy's json
# encoder emits ts (epoch float), duration, status, and request.uri,
# which is exactly what that job parses. Rolled to keep disk bounded.
#
# The filter masks the keys Nakama RPC callers put in the query
# string: http_key (game servers, ops scripts, clients up to 0.47.0)
# and admin_key (register_game). request.uri is logged verbatim
# otherwise, and caddy-access-analytics reports the top URIs, so an
# unmasked key would land in its report.
(accesslog) {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 5
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					replace http_key REDACTED
					replace admin_key REDACTED
				}
			}
		}
	}
}

nakama.snoringcat.games {
	import accesslog
	encode gzip

	# Request-body guard. No client sends a compressed
	# request body (the SDK and the game use plain JSON),
	# so refuse encoded requests outright, and cap every
	# other body at the API's own request size limit.
	@encoded header Content-Encoding *
	respond @encoded "unsupported content encoding" 415
	@capped not path /ws
	request_body @capped {
		max_size 256KiB
	}

	# Per-IP rate limit on the unauthenticated authentication
	# endpoints. 30 attempts per IP per 5 min is generous for
	# legit (typo-and-retry) flows but kills brute-force quickly.
	# Returns 429 with a Retry-After header.
	@auth_endpoints path /v2/account/authenticate*
	rate_limit @auth_endpoints {
		zone authenticate {
			key {remote_host}
			events 30
			window 5m
		}
	}

	# Per-IP rate limits on the two unauthenticated runtime routes.
	# Both are cheap: the leaderboard is served from a cache the
	# runtime refills at most once a minute per board (and once after
	# each match), and the version check is answered from memory. So
	# the limits only stop a single address from looping, and are
	# sized for many real players behind one address (a school, a
	# cafe, a carrier NAT), since the game itself calls both: one
	# version check per launch, and one leaderboard read each time a
	# player opens it in game or on the website. A limited request
	# gets the 429 from handle_errors below.
	@public_leaderboard path /snoringcat/leaderboard
	rate_limit @public_leaderboard {
		zone public_leaderboard {
			key {remote_host}
			events 300
			window 1m
		}
	}
	@version_check path /snoringcat/version_check
	rate_limit @version_check {
		zone version_check {
			key {remote_host}
			events 600
			window 1m
		}
	}

	# Nakama HTTP API + WebSocket realtime endpoint (/ws).
	# flush_interval -1 disables response buffering — required for
	# low-latency realtime traffic.
	reverse_proxy nakama:7350 {
		flush_interval -1
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	# Rate-limit refusals. caddy-ratelimit answers a request over its
	# zone's limit by returning a 429 error (with Retry-After already
	# set), and Caddy routes errors here. Nakama answers every origin,
	# so its refusals do too: without Access-Control-Allow-Origin a
	# browser reports a failed fetch, not a 429. The public routes
	# also get a JSON body in their own error format. Other errors
	# keep Caddy's default handling.
	handle_errors 429 {
		header Access-Control-Allow-Origin "*"
		@public_routes path /snoringcat/leaderboard /snoringcat/version_check
		handle @public_routes {
			header Content-Type application/json
			header Cache-Control no-store
			header Cross-Origin-Resource-Policy cross-origin
			header X-Content-Type-Options nosniff
			respond `{"version":1,"error":"rate_limited","message":"too many requests; retry after Retry-After seconds"}` 429
		}
	}
}

# Grafana UI fronted by Caddy TLS. Restored 2026-05-13 in
# Stage 7.11 (lightweight obs re-introduction). Auth handled
# by Grafana itself (admin user provisioned via env in the
# compose; password is GRAFANA_ADMIN_PASSWORD in
# /opt/nakama/.env).
grafana.snoringcat.games {
	import accesslog
	encode gzip

	reverse_proxy grafana:3000 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# WebSocket signaling proxy. Stable hostname in front of the
# dynamic Edgegap deploy. Caddy terminates TLS once;
# signaling-proxy validates the HMAC token in the URL and
# bridges to the upstream game-server. See
# infra/remote/signaling-proxy/main.go for the protocol. The
# upstream is a sibling docker-compose service on the same
# nakama-net network; reachable via the service's DNS name.
signaling.snoringcat.games {
	import accesslog
	encode gzip

	reverse_proxy signaling-proxy:4435 {
		flush_interval -1
		# WebSocket upgrade is automatic in Caddy 2.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
